{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...slug].ts": {
      "includeFiles": "{wrangler.toml,worker-package.json,src/index.ts,src/matcher.ts,src/ui.ts}"
    }
  },
  "rewrites": [
    {
      "source": "/manifest.json",
      "destination": "/api/manifest.json"
    },
    {
      "source": "/worker-ui",
      "destination": "/api/worker-ui"
    },
    {
      "source": "/:config/manifest.json",
      "destination": "/api/:config/manifest.json"
    },
    {
      "source": "/:config/catalog/:type/:id.json",
      "destination": "/api/:config/catalog/:type/:id.json"
    },
    {
      "source": "/:config/catalog/:type/:id/:extra.json",
      "destination": "/api/:config/catalog/:type/:id/:extra.json"
    },
    {
      "source": "/:config/stream/:type/:id.json",
      "destination": "/api/:config/stream/:type/:id.json"
    },
    {
      "source": "/configure",
      "destination": "/index.html"
    },
    {
      "source": "/:config/configure",
      "destination": "/index.html"
    }
  ]
}
