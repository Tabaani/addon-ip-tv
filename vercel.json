{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/addon.ts": {
      "includeFiles": "{wrangler.toml,worker-package.json,src/index.ts,src/matcher.ts,src/ui.ts}"
    }
  },
  "rewrites": [
    {
      "source": "/api/test",
      "destination": "/api/addon?__route=test"
    },
    {
      "source": "/api/live-channels",
      "destination": "/api/addon?__route=live-channels"
    },
    {
      "source": "/api/worker-source",
      "destination": "/api/addon?__route=worker-source"
    },
    {
      "source": "/manifest.json",
      "destination": "/api/addon?__route=root-manifest"
    },
    {
      "source": "/worker-ui",
      "destination": "/api/addon?__route=worker-ui"
    },
    {
      "source": "/tv/:config/manifest.json",
      "destination": "/api/addon?__route=tv-manifest&config=:config"
    },
    {
      "source": "/tv/:config/catalog/tv/:id.json",
      "destination": "/api/addon?__route=tv-catalog&config=:config&id=:id"
    },
    {
      "source": "/tv/:config/catalog/tv/:id/:extra.json",
      "destination": "/api/addon?__route=tv-catalog&config=:config&id=:id&extra=:extra"
    },
    {
      "source": "/tv/:config/meta/tv/:id.json",
      "destination": "/api/addon?__route=tv-meta&config=:config&id=:id"
    },
    {
      "source": "/tv/:config/stream/tv/:id.json",
      "destination": "/api/addon?__route=tv-stream&config=:config&id=:id"
    },
    {
      "source": "/tv/:config/configure",
      "destination": "/index.html"
    },
    {
      "source": "/:config/manifest.json",
      "destination": "/api/addon?__route=manifest&config=:config"
    },
    {
      "source": "/:config/catalog/:type/:id.json",
      "destination": "/api/addon?__route=catalog&config=:config&type=:type&id=:id"
    },
    {
      "source": "/:config/catalog/:type/:id/:extra.json",
      "destination": "/api/addon?__route=catalog&config=:config&type=:type&id=:id&extra=:extra"
    },
    {
      "source": "/:config/meta/:type/:id.json",
      "destination": "/api/addon?__route=meta&config=:config&type=:type&id=:id"
    },
    {
      "source": "/:config/stream/:type/:id.json",
      "destination": "/api/addon?__route=stream&config=:config&type=:type&id=:id"
    },
    {
      "source": "/configure",
      "destination": "/index.html"
    },
    {
      "source": "/:config/configure",
      "destination": "/index.html"
    }
  ]
}
